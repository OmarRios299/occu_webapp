{
  "name": "occu-vnext",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:cliente": "npm --workspace apps/web-cliente run dev",
    "dev:panel": "npm --workspace apps/web-panel run dev -- --port 5174",
